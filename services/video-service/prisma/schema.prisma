// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VideoVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Video {
  id              String @id @default(uuid()) @db.Uuid

  // MVP simplification: no cross-service FK to user-service's Channel table,
  // this is just the uploader's userId from the JWT.
  channelId       String @db.Uuid @map("channel_id")

  title           String @db.VarChar(255)

  description     String?

  thumbnailUrl    String? @map("thumbnail_url")

  videoUrl        String @map("video_url")

  durationSeconds Int @default(0) @map("duration_seconds")

  viewCount       Int @default(0) @map("view_count")

  visibility      VideoVisibility @default(PUBLIC)

  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  updatedAt       DateTime @updatedAt @map("updated_at")

  reactions       VideoReaction[]

  comments        Comment[]

  @@index([channelId])

  @@index([uploadedAt])

  @@index([visibility])

  @@map("videos")
}

model Comment {
  id        String @id @default(uuid()) @db.Uuid

  videoId   String @db.Uuid @map("video_id")

  // Same MVP simplification as Video.channelId: the commenter's userId from
  // the JWT, with no cross-service FK to user-service's Profile table.
  authorId  String @db.Uuid @map("author_id")

  // Set for replies, null for top-level comments. One level deep only.
  parentId  String? @db.Uuid @map("parent_id")

  text      String @db.VarChar(2000)

  edited    Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  video     Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies   Comment[] @relation("CommentReplies")

  @@index([videoId, createdAt])

  @@index([parentId])

  @@index([authorId])

  @@map("comments")
}

/// One row per user per video. `type` makes like and dislike mutually
/// exclusive by construction — switching sides updates the row rather than
/// creating a second one.
model VideoReaction {
  videoId   String   @db.Uuid @map("video_id")

  userId    String   @db.Uuid @map("user_id")

  type      ReactionType @default(LIKE)

  reactedAt DateTime @default(now()) @map("reacted_at")

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])

  @@index([userId])

  @@index([videoId, type])

  @@map("video_reactions")
}
