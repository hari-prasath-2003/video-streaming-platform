// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VideoVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Video {
  id              String @id @default(uuid()) @db.Uuid

  // MVP simplification: no cross-service FK to user-service's Channel table,
  // this is just the uploader's userId from the JWT.
  channelId       String @db.Uuid @map("channel_id")

  title           String @db.VarChar(255)

  description     String?

  thumbnailUrl    String? @map("thumbnail_url")

  videoUrl        String @map("video_url")

  durationSeconds Int @default(0) @map("duration_seconds")

  viewCount       Int @default(0) @map("view_count")

  visibility      VideoVisibility @default(PUBLIC)

  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  updatedAt       DateTime @updatedAt @map("updated_at")

  likes           VideoLike[]

  @@index([channelId])

  @@index([uploadedAt])

  @@index([visibility])

  @@map("videos")
}

model VideoLike {
  videoId String   @db.Uuid @map("video_id")

  userId  String   @db.Uuid @map("user_id")

  likedAt DateTime @default(now()) @map("liked_at")

  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, userId])

  @@index([userId])

  @@map("video_likes")
}
