pipeline {
    agent any

    environment {
        IMAGE_NAME = "nextjs-demo"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG .'
            }
        }

        stage('Deploy') {
            steps {
                echo "Application deployed successfully!"
            }
        }
    }
}